# Supabase — use local `supabase start` values or your project dashboard
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App name
NEXT_PUBLIC_APP_NAME=ecommerce


# Order email notifications (Nodemailer / Gmail App Password) — server only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="De Tin Marín <your-gmail@gmail.com>"
# Optional — Reply-To (respuestas del cliente van aquí; From puede seguir siendo SMTP_USER)
SMTP_REPLY_TO=detinmarindulcesyconfiteria@gmail.com
# Optional; leave empty/unset in production (admin uses public_business_settings.email)
ORDER_NOTIFY_EXTRA_EMAILS=erivasruiz03@gmail.com
# Optional absolute bases for email links
ORDER_ECOMMERCE_APP_BASE_URL=http://localhost:3000
ORDER_ADMIN_APP_BASE_URL=http://localhost:3001
